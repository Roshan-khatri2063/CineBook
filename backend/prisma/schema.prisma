// CineBook Lite - database schema (single cinema, roles: CUSTOMER and ADMIN)
//
// Extra rules that Prisma cannot express (CHECK constraints, no-overlap and
// no-double-booking constraints) live in prisma/constraints.sql and are added
// to the first migration. See the README for the steps.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------- Enums

enum Role {
  CUSTOMER
  ADMIN
}

enum MovieStatus {
  NOW_SHOWING
  COMING_SOON
  ENDED
}

enum SeatType {
  STANDARD
  PREMIUM
}

enum ShowtimeStatus {
  SCHEDULED
  CANCELLED
}

enum ShowSeatStatus {
  AVAILABLE
  BOOKED
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
}

enum PaymentStatus {
  PAID
  REFUNDED
}

enum TicketStatus {
  VALID
  CANCELLED
}

// ---------------------------------------------------------------- Models

model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique // always store lowercase (done in the auth module)
  passwordHash String
  phone        String?
  role         Role     @default(CUSTOMER)
  isActive     Boolean  @default(true) // admin can deactivate a customer
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  bookings Booking[]

  @@index([role])
  @@map("users")
}

model Movie {
  id              Int         @id @default(autoincrement())
  title           String
  description     String      @db.Text
  genre           String
  language        String
  durationMinutes Int
  releaseDate     DateTime    @db.Date
  ageRating       String? // e.g. "PG-13"
  posterUrl       String?
  trailerUrl      String?
  status          MovieStatus @default(COMING_SOON)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  showtimes Showtime[]

  @@index([status])
  @@index([genre])
  @@index([language])
  @@map("movies")
}

model Screen {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  seats     Seat[]
  showtimes Showtime[]

  @@map("screens")
}

// Physical seat in a screen. Never changes per showtime.
model Seat {
  id         Int      @id @default(autoincrement())
  screenId   Int
  rowLabel   String // "A", "B", ...
  seatNumber Int // 1, 2, 3, ...
  type       SeatType @default(STANDARD)
  isActive   Boolean  @default(true) // false = broken or removed seat
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  screen    Screen     @relation(fields: [screenId], references: [id], onDelete: Cascade)
  showSeats ShowSeat[]

  @@unique([screenId, rowLabel, seatNumber])
  @@map("seats")
}

model Showtime {
  id            Int            @id @default(autoincrement())
  movieId       Int
  screenId      Int
  startTime     DateTime
  endTime       DateTime
  standardPrice Decimal        @db.Decimal(10, 2)
  premiumPrice  Decimal        @db.Decimal(10, 2)
  status        ShowtimeStatus @default(SCHEDULED)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  movie     Movie      @relation(fields: [movieId], references: [id], onDelete: Restrict)
  screen    Screen     @relation(fields: [screenId], references: [id], onDelete: Restrict)
  showSeats ShowSeat[]
  bookings  Booking[]

  @@index([movieId, startTime])
  @@index([screenId, startTime])
  @@index([startTime])
  @@map("showtimes")
}

// One seat for one showtime. This is where availability is tracked.
model ShowSeat {
  id         Int            @id @default(autoincrement())
  showtimeId Int
  seatId     Int
  status     ShowSeatStatus @default(AVAILABLE)
  price      Decimal        @db.Decimal(10, 2) // price snapshot for this showtime
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  showtime     Showtime      @relation(fields: [showtimeId], references: [id], onDelete: Cascade)
  seat         Seat          @relation(fields: [seatId], references: [id], onDelete: Restrict)
  bookingSeats BookingSeat[]

  @@unique([showtimeId, seatId])
  @@index([showtimeId, status])
  @@index([seatId])
  @@map("show_seats")
}

model Booking {
  id               Int           @id @default(autoincrement())
  bookingReference String        @unique // e.g. CB-20261102-7K3QX9
  userId           Int
  showtimeId       Int
  status           BookingStatus @default(CONFIRMED)
  totalAmount      Decimal       @db.Decimal(10, 2)
  paymentStatus    PaymentStatus @default(PAID)
  paymentReference String?       @unique // fake transaction id from the simulated payment
  paidAt           DateTime?
  cancelledAt      DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  showtime     Showtime      @relation(fields: [showtimeId], references: [id], onDelete: Restrict)
  bookingSeats BookingSeat[]

  @@index([userId, createdAt])
  @@index([showtimeId])
  @@index([status])
  @@map("bookings")
}

// One row per seat in a booking. Rows are kept after cancellation (isActive = false).
model BookingSeat {
  id         Int      @id @default(autoincrement())
  bookingId  Int
  showSeatId Int
  price      Decimal  @db.Decimal(10, 2)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  booking  Booking  @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  showSeat ShowSeat @relation(fields: [showSeatId], references: [id], onDelete: Restrict)
  ticket   Ticket?

  @@unique([bookingId, showSeatId])
  @@index([showSeatId])
  @@map("booking_seats")
}

// Digital ticket, one per booked seat. The QR code is generated from ticketCode.
model Ticket {
  id            Int          @id @default(autoincrement())
  ticketCode    String       @unique
  bookingSeatId Int          @unique
  status        TicketStatus @default(VALID)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  bookingSeat BookingSeat @relation(fields: [bookingSeatId], references: [id], onDelete: Cascade)

  @@map("tickets")
}
